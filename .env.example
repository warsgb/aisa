# Frontend Environment Configuration
# Copy this file to .env.local and customize for your environment

# Backend API URL
# Development: Use /api for Vite proxy (recommended)
# Production: Set to full backend URL e.g., http://your-server:3001/api
# Note: Backend has global /api prefix
VITE_API_URL=/api

# WebSocket URL
# Development: Use /ws for Vite proxy (recommended)
# Production: Set to full WS URL e.g., ws://your-server:3001
VITE_WS_URL=/ws
