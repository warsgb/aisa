# Frontend Environment Configuration
# Copy this file to .env.local and customize for your environment

# Backend API URL
# Development: Use /api for Vite proxy (recommended)
# Production: Set to full backend URL e.g., http://your-server:3001/api
# Note: Backend has global /api prefix
VITE_API_URL=/api

# Backend Direct URL (for static files like customer360)
# Production: Set to full backend URL e.g., http://your-server:3001
# Development: Use http://localhost:3001
VITE_BACKEND_URL=http://localhost:3001

# Kuaicha Auto-Fill Toggle
# Development: Use /api for Vite proxy (recommended)
# Production: Set to full backend URL e.g., http://your-server:3001/api
# Note: Backend has global /api prefix
VITE_API_URL=/api

# Kuaicha Auto-Fill Toggle
# Set to 'true' to enable Kuaicha (快查) for AI auto-fill, 'false' to use Baidu search fallback
USE_KUAICHA_FOR_AUTO_FILL=true

# WebSocket URL
# Development: Use /ws for Vite proxy (recommended)
# Production: Set to full WS URL e.g., ws://your-server:3001
VITE_WS_URL=/ws
